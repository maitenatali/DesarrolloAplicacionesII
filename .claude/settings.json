{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "15000"
  },
  "permissions": {
    "allow": [
      "Read(./docs/**)",
      "Read(./specs/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./.venv/**)",
      "Read(./venv/**)",
      "Read(./vendor/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./out/**)",
      "Read(./.next/**)",
      "Read(./target/**)",
      "Read(./coverage/**)",
      "Read(./.git/**)",
      "Read(./**/*.min.js)",
      "Read(./**/*.map)",
      "Read(./**/package-lock.json)",
      "Read(./**/yarn.lock)",
      "Read(./**/pnpm-lock.yaml)",
      "Read(./**/poetry.lock)",
      "Read(./**/Cargo.lock)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/mark-docs-stale.sh\""
          }
        ]
      }
    ]
  }
}
