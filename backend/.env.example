# ── Runtime ──────────────────────────────────────────────
APP_ENV=development                # development | test | production
PORT=8080
APP_TIMEZONE=America/Argentina/Buenos_Aires
LOG_LEVEL=INFO
CORS_ORIGINS=                      # empty = CORS disabled (same-origin via gateway/Vite proxy)

# ── Database ─────────────────────────────────────────────
# Supabase: SESSION POOLER, user postgres.<project-id>, sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/teacher
DB_POOL_SIZE=5
DB_POOL_RECYCLE=1800

# ── Auth ─────────────────────────────────────────────────
AUTH_VERIFIER=dev                  # introspect (opaque bearer via CORE /auth/me) | jwt (future) | dev (local only)
TOKEN_CACHE_TTL_SECONDS=60
TOKEN_CACHE_MAX_ENTRIES=2000
CORE_ME_PATH=/api/v1/auth/me
SERVICE_TOKENS=                    # comma-separated static tokens accepted on service-only routes (/results)
CORE_JWKS_URL=https://core-api-production-e458.up.railway.app/.well-known/jwks.json
JWT_ALGORITHMS=RS256               # [OPEN] confirm with CORE
JWT_ISSUER=
JWT_AUDIENCE=
JWT_LEEWAY_SECONDS=30
TEACHER_ROLES=ROLE_DOCENTE,ROLE_TEACHER               # [OPEN]
SERVICE_ROLES=ROLE_SERVICE,ROLE_ADMINISTRATIVO        # [OPEN]
ADMIN_ROLES=ROLE_ADMINISTRATIVO,ROLE_ACADEMIC_ADMIN
DOCENTE_ID_CLAIMS=sub,email,email_local               # [OPEN] CORE user <-> GA docenteId mapping
GATEWAY_HMAC_ENABLED=false         # [OPEN] header format unknown; enabling fails closed
GATEWAY_HMAC_SECRET=

# ── Outbound auth (how WE authenticate to other modules) ─
ACADEMIC_AUTH_VERIFIER=static_bearer     # static_bearer | service_token | none
ACADEMIC_STATIC_TOKEN=
CORE_EVENTS_AUTH_VERIFIER=service_token
CORE_EVENTS_STATIC_TOKEN=
STUDENT_DIRECTORY_AUTH_VERIFIER=static_bearer
STUDENT_DIRECTORY_STATIC_TOKEN=

# ── Integrations ─────────────────────────────────────────
INTEGRATIONS_MODE=mock             # mock | live
ACADEMIC_MODE=
CORE_EVENTS_MODE=
STUDENT_DIRECTORY_MODE=
CORE_BASE_URL=https://core-api-production-e458.up.railway.app
CORE_SERVICE_CLIENT_ID=
CORE_SERVICE_CLIENT_SECRET=
ACADEMIC_BASE_URL=                 # gateway prefix [OPEN: /api vs /api/v1]
ACADEMIC_SUPPORTS_TEACHER_FILTER=false
STUDENT_DIRECTORY_BASE_URL=        # [OPEN]
HTTP_TIMEOUT_CONNECT=3
HTTP_TIMEOUT_READ=8
HTTP_MAX_RETRIES=2
ACADEMIC_COURSE_CACHE_TTL=60
ACADEMIC_FANOUT_CONCURRENCY=6

# ── Business ─────────────────────────────────────────────
PASSING_GRADE=4.0
REGULAR_THRESHOLD=75.0             # informational: the asistencia_por_alumno view is authoritative
FINAL_EXAM_TYPES=FINAL
FINAL_REQUIRES_REGULAR=true
LOCK_AFTER_ACTA=true
ANNUL_REVERTS_ACADEMIC=false       # [OPEN] not implemented; flag only logs

# ── Outbox / events ──────────────────────────────────────
OUTBOX_POLL_SECONDS=5
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
EVENTS_INLINE_DISPATCH=true
