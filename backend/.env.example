# ── Runtime ──────────────────────────────────────────────
APP_ENV=development                # development | test | production
PORT=8080
APP_TIMEZONE=America/Argentina/Buenos_Aires
LOG_LEVEL=INFO
# empty = CORS disabled (same-origin via gateway/Vite proxy)
CORS_ORIGINS=

# ── Database ─────────────────────────────────────────────
# Supabase: SESSION POOLER, user postgres.<project-id>, sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/teacher
DB_POOL_SIZE=5
DB_POOL_RECYCLE=1800

# ── Auth ─────────────────────────────────────────────────
# CORE issues RS256 JWTs (user + service tokens, same scheme). We verify them LOCALLY against the JWKS.
AUTH_VERIFIER=jwt                  # jwt (CORE contract) | introspect (ask CORE /auth/me) | dev (X-Dev-User, local only)
# empty + MOCK_CORE_ENABLED=true -> use the local simulator's key
CORE_JWKS_URL=
                                   # real CORE: https://core-api-production-e458.up.railway.app/.well-known/jwks.json
JWT_ALGORITHMS=RS256
JWT_ISSUER=uadenet-core            # TODO(CORE): confirm real `iss`/`aud`; empty = not checked
JWT_AUDIENCE=uadenet
JWT_LEEWAY_SECONDS=30
TOKEN_CACHE_TTL_SECONDS=60         # introspect only
TOKEN_CACHE_MAX_ENTRIES=2000
CORE_ME_PATH=/api/v1/auth/me
TEACHER_ROLES=TEACHER              # Backoffice/CORE role catalog: STUDENT, TEACHER, ADMIN_IT, ADMIN_STAFF, ACADEMIC_ADMIN...
ADMIN_ROLES=ACADEMIC_ADMIN,ADMIN_STAFF   # read-only support access to any course
SERVICE_MODULES=student,analytics  # CORE service tokens (kind=service) allowed on /results
SERVICE_ROLES=SERVICE
# optional static tokens for /results (comma-separated)
SERVICE_TOKENS=
GATEWAY_HMAC_ENABLED=false         # TODO(CORE): X-Core-Signature format not published; enabling fails closed
GATEWAY_HMAC_SECRET=

# ── Local CORE simulator (this delivery runs WITHOUT the other modules) ─────
MOCK_CORE_ENABLED=true             # serves /api/v1/auth/*, /.well-known/jwks.json, /api/v1/wallets/me*, /api/v1/notifications*
MOCK_CORE_SERVICE_CLIENTS=student-service:change-me   # clientId:secret pairs for /internal/v1/service-auth/token
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
STUDENT_PORTAL_BASE_URL=/student   # prefix of actionUrl in notifications sent to students

# ── Outbound auth (how WE authenticate to other modules) ─
ACADEMIC_AUTH_VERIFIER=static_bearer     # static_bearer | service_token | none
ACADEMIC_STATIC_TOKEN=
CORE_EVENTS_AUTH_VERIFIER=service_token
CORE_EVENTS_STATIC_TOKEN=
STUDENT_DIRECTORY_AUTH_VERIFIER=static_bearer
STUDENT_DIRECTORY_STATIC_TOKEN=

# ── Integrations ─────────────────────────────────────────
INTEGRATIONS_MODE=mock             # mock | live
ACADEMIC_MODE=
CORE_EVENTS_MODE=
# live = Backoffice GET /api/v1/users/{userId}
STUDENT_DIRECTORY_MODE=
# live = CORE POST /internal/v1/notifications
NOTIFICATIONS_MODE=
CORE_BASE_URL=https://core-api-production-e458.up.railway.app
CORE_SERVICE_CLIENT_ID=
CORE_SERVICE_CLIENT_SECRET=
# GA backend, routes under /api (e.g. https://ga/api)
ACADEMIC_BASE_URL=
ACADEMIC_SUPPORTS_TEACHER_FILTER=false
# Backoffice backend base URL
STUDENT_DIRECTORY_BASE_URL=
HTTP_TIMEOUT_CONNECT=3
HTTP_TIMEOUT_READ=8
HTTP_MAX_RETRIES=2
ACADEMIC_COURSE_CACHE_TTL=60
ACADEMIC_FANOUT_CONCURRENCY=6

# ── Business ─────────────────────────────────────────────
PASSING_GRADE=4.0
REGULAR_THRESHOLD=75.0             # informational: the asistencia_por_alumno view is authoritative
FINAL_EXAM_TYPES=FINAL
FINAL_REQUIRES_REGULAR=true
LOCK_AFTER_ACTA=true
ANNUL_REVERTS_ACADEMIC=false       # [OPEN] not implemented; flag only logs

# ── Outbox / events ──────────────────────────────────────
OUTBOX_POLL_SECONDS=5
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
EVENTS_INLINE_DISPATCH=true
